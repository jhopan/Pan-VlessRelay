# Port relay (TCP — worker menyambung ke sini). Buka di firewall: TCP 7300.
RELAY_PORT=7300
RELAY_HOST=0.0.0.0

# WAJIB. Samakan dengan binding RELAY_SECRET di worker VLESS.
# Buat yang panjang & acak, mis.: openssl rand -hex 32
RELAY_SECRET=ganti-dengan-rahasia-panjang-acak

# Tutup sesi UDP yang tidak ada trafik selama ini (ms).
RELAY_IDLE_MS=60000

# Batas ukuran satu datagram (byte). Lebih besar dari ini dibuang.
RELAY_MAX_DATAGRAM=8192

# TLS (opsional). Kalau diaktifkan, sertakan RELAY_CERT & RELAY_KEY (mount ke container)
# dan set RELAY_SERVER_TLS=1 di worker.
RELAY_TLS=0
# RELAY_CERT=/certs/fullchain.pem
# RELAY_KEY=/certs/privkey.pem
